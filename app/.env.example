# ==============================================================================
# WhatsFlow Engine — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite arquivos .env com valores reais.
# ==============================================================================

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
MASTER_PASSWORD=troque-esta-senha
WHATSFLOW_API_KEY=gere-uma-chave-forte
WHATSFLOW_ADMIN_KEY=gere-outra-chave-forte
INSTALLER_ENABLED=true

# --- Supabase (banco + auth + storage) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SECRET_KEY=sua-service-role-key
SUPABASE_ACCESS_TOKEN=seu-access-token-para-provisionamento
DATABASE_URL=postgresql://postgres:senha@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Meta WhatsApp Cloud API (API Oficial) -------------------------------------
META_APP_ID=seu-app-id
META_APP_SECRET=seu-app-secret
WEBHOOK_BASE_URL=https://sua-app.vercel.app
WEBHOOK_VERIFY_TOKEN=token-de-verificacao-do-webhook

# --- Filas e throttling (Upstash) ----------------------------------------------
QSTASH_TOKEN=seu-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sua-signing-key
QSTASH_NEXT_SIGNING_KEY=sua-next-signing-key
UPSTASH_REDIS_REST_URL=https://sua-instancia.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-redis-token

# --- IA (opcionais — habilite os providers que usar) ---------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
MEM0_API_KEY=

# --- Push notifications (Web Push / VAPID) -------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Deploy automatizado (opcional — installer Vercel) --------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Integrações opcionais ------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
RESEND_API_KEY=

# --- Throttling adaptativo (anti-bloqueio preventivo; padrões seguros embutidos) --
WHATSAPP_ADAPTIVE_THROTTLE=true
WHATSAPP_ADAPTIVE_START_MPS=
WHATSAPP_ADAPTIVE_MIN_MPS=
WHATSAPP_ADAPTIVE_MAX_MPS=
WHATSAPP_ADAPTIVE_COOLDOWN_SEC=
WHATSAPP_ADAPTIVE_MIN_INCREASE_GAP_SEC=
WHATSAPP_STATUS_DEDUPE_TTL_SECONDS=
