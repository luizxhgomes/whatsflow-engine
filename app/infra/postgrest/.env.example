# Somente placeholders. Nenhuma credencial real deve entrar neste arquivo.
# Host candidato verificado: whatsflow-rest.ynbpe5.easypanel.host
WHATSFLOW_REST_HOST=HOST_APROVADO
# Usar host DIRETO do Neon e a role limitada, nunca neondb_owner/authenticator.
PGRST_DB_URI=postgresql://whatsflow_rest@NEON_DIRECT_HOST:5432/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
# Gerar somente após autorização e guardar no cofre canônico via chaves.
WHATSFLOW_POSTGREST_PASSWORD=SEGREDO_DA_ROLE_LIMITADA
# JSON público inline, sem d/p/q/dp/dq/qi, sem URL JWKS e sem chave privada.
NEON_DATA_API_PUBLIC_JWK={"kty":"RSA","n":"MODULO_PUBLICO","e":"AQAB","alg":"RS256","use":"sig","kid":"whatsflow-data-v1"}
